# =====================================================================
#  SynapseAI Lab — Variables de entorno
#  Copia este archivo como `.env` y completa los valores:
#     cp .env.example .env      (Linux/macOS)
#     copy .env.example .env    (Windows CMD)
# =====================================================================

# ---------------------------------------------------------------------
# 1) SERVIDOR NODE / EXPRESS
# ---------------------------------------------------------------------
PORT=3000
NODE_ENV=development.

# Secreto para firmar la cookie de sesión (cookie-session / express-session).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_este_valor_por_un_secreto_aleatorio_de_64_chars

# Almacén de sesiones:
#   memory -> en RAM (rápido, ideal en desarrollo; se pierde al reiniciar)
#   mysql  -> en la base de datos (OBLIGATORIO en Render/Koyeb/Vercel gratis,
#             porque esas plataformas apagan la instancia y perderías la sesión)
SESSION_STORE=memory
SESSION_POOL_SIZE=3

# Orígenes permitidos para CORS (separados por coma). Déjalo vacío = mismo origen.
CORS_ORIGINS=

# ---------------------------------------------------------------------
# 2) BASE DE DATOS — AIVEN MySQL Cloud
#    Aiven > Projects > tu proyecto > Service > MySQL > Connection
# ---------------------------------------------------------------------
DB_HOST=tu-servicio-mysql-proyecto.aivencloud.com
DB_PORT=3306
DB_USER=tu_usuario_aiven
DB_PASSWORD=tu_password_aiven
DB_NAME=synapseai_lab

# Alias admitidos por db.js si tu proveedor usa otros nombres:
#   HOST / USER / PASSWORD / DATABASE  (valores heredados del enunciado)
# DB_HOST=      -> HOST
# DB_USER=      -> USER
# DB_PASSWORD=  -> PASSWORD
# DB_NAME=      -> DATABASE
HOST=
USER=
PASSWORD=
DATABASE=

# --- SSL (Aiven exige TLS) ---
# Ponlo en "true" cuando uses Aiven Cloud (o cualquier servidor remoto).
DB_SSL=true

# Aiven usa certificado autofirmado. Opción A (simple, la más común):
#   rejectUnauthorized=false  -> el cifrado sigue activo pero no se valida la CA
DB_SSL_REJECT_UNAUTHORIZED=false

# Opción B (recomendada en producción): descarga el CA de Aiven
# (Aiven > Service > MySQL > "CA certificate" > Download CA) y pon aquí
# la ruta al archivo .crt. Con esto se valida la cadena completa.
DB_SSL_CA=

# Tamaño del pool de conexiones
DB_POOL_SIZE=10

# ---------------------------------------------------------------------
# 3) GOOGLE IDENTITY SERVICES (Sign-In / Verificación de correo)
#    Consola de Google Cloud > APIs y servicios > Credenciales
#    > Credenciales de cliente OAuth 2.0 > ID de cliente web
#    > Orígenes JS autorizados: http://localhost:3000 y https://tu-dominio.com
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com

# Dominio de empresa restringido (opcional). Si está vacío, se acepta
# cualquier cuenta @gmail.com o de cualquier proveedor.
GOOGLE_HOSTED_DOMAIN=

# Muestra u oculta el botón oficial de Google Sign-In.
#   true  -> se muestra (comportamiento original)
#   false -> el registro solo se hace con correo + contraseña del buzón,
#            y el formulario NO muestra sugerencias de Google
GOOGLE_SIGNIN_ENABLED=true

# ---------------------------------------------------------------------
# 3.1) VERIFICACIÓN REAL DEL BUZÓN (IMAP)
#
#      Al registrarse, el backend se autentica en el servidor IMAP del
#      proveedor con el correo y la contraseña introducidos. Así se comprueba
#      que la cuenta de correo es REAL y que la persona la controla.
#      La contraseña solo se usa para ese intento: no se guarda aparte.
#
#      MAIL_VERIFY_MODE=imap -> verifica de verdad (recomendado)
#      MAIL_VERIFY_MODE=off  -> solo valida el formato del correo
# ---------------------------------------------------------------------
MAIL_VERIFY_MODE=imap
IMAP_TIMEOUT_MS=10000

# ---------------------------------------------------------------------
# 3.2) CÓDIGO DE VERIFICACIÓN POR CORREO (OTP de un solo uso)
# ---------------------------------------------------------------------
OTP_TTL_MINUTOS=10
OTP_MAX_INTENTOS=5
OTP_SALT=

# ---------------------------------------------------------------------
# 3.3) PROXY (Render, Koyeb, Vercel, Aiven)
#      Número de proxies delante de la app: 1 en producción, 0 en local.
# ---------------------------------------------------------------------
TRUST_PROXY=0

# ---------------------------------------------------------------------
# 4) SMTP
#    ⚠️ NO escribas aquí contraseñas reales: este archivo se sube al repositorio
#       y GitHub bloquea el push si detecta secretos (Push Protection).
#       Tus valores reales van en `.env` (ignorado por Git) o en el panel
#       de variables de entorno de tu plataforma de hosting. — Notificación al administrador (nodemailer)
#    Ejemplo Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu@gmail.com
#    Ejemplo Outlook: SMTP_HOST=smtp.office365.com SMTP_PORT=587
#    Ejemplo Aiven/otro: SMTP_HOST=mail.tu-servidor.com
# ---------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xxxxxxx@smtp-relay.brevo.com
SMTP_PASS=xsmtp-relay.xxxxxxxxxxxx
SMTP_REQUIRE_TLS=true

# Correo destino donde llega la notificación de cada registro nuevo.
ADMIN_EMAIL=admin@synapseailab.com

# Nombre que se muestra como remitente en el correo.
MAIL_FROM_NAME=SynapseAI Lab

# Enviar también un correo de bienvenida al nuevo usuario (opcional).
SMTP_SEND_USER_COPY=false

# ---------------------------------------------------------------------
# 5) BONO DE BIENVENIDA
#    Saldo inicial que se acredita al completar el registro (USD).
# ---------------------------------------------------------------------
BONUS_USD=1.00
